#!/bin/bash
# Campfire live wallpaper for Omarchy: the OmaFire campfire (Wes Grimes, MIT) burning in a loop behind the desktop
# while the campfire theme is on; stopped for any other theme.
# (c) 2026 Marco Porro (x.com/MarcoPorro), MIT. Needs mpvpaper. Installed by extras/install-live.
# Called as an Omarchy theme-set hook ($1 = theme name, starts it in the background), with no argument (the current
# theme), or with --login from ~/.config/autostart (the current theme; mpvpaper stays in the foreground of that unit).
login=0
[[ ${1:-} == --login ]] && { login=1; shift; }
theme="${1:-$(cat "$HOME/.local/state/omarchy/current/theme.name" 2>/dev/null)}"
video="$HOME/.config/omarchy/themes/campfire/extras/campfire-loop.mp4"
conf="$HOME/.config/omarchy/campfire-live.conf"   # SOUND=1 plays the fire and the night (volume VOLUME, default 40)
SOUND=0; VOLUME=40
[[ -f $conf ]] && . "$conf"
# From SSH, a service or the TV (omarchy-link) there may be no Wayland session in the environment: find Hyprland's.
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
[[ -n $WAYLAND_DISPLAY ]] || WAYLAND_DISPLAY="$(ls "$XDG_RUNTIME_DIR" 2>/dev/null | grep -m1 -E '^wayland-[0-9]+$')"
[[ -n $HYPRLAND_INSTANCE_SIGNATURE ]] || HYPRLAND_INSTANCE_SIGNATURE="$(ls -t "$XDG_RUNTIME_DIR/hypr" 2>/dev/null | head -1)"
export WAYLAND_DISPLAY HYPRLAND_INSTANCE_SIGNATURE
log="${XDG_CACHE_HOME:-$HOME/.cache}/campfire-live.log"
mkdir -p "$(dirname "$log")"
systemctl --user stop campfire-live.service 2>/dev/null
pkill -x mpvpaper 2>/dev/null
[[ $theme == campfire && -f $video ]] || exit 0
command -v mpvpaper >/dev/null || { echo "campfire-live: mpvpaper is not installed (extras/install-live)" >&2; exit 0; }
opts="loop no-audio really-quiet"   # really-quiet: no status line every frame in the log
[[ $SOUND == 1 ]] && opts="loop volume=$VOLUME really-quiet"
: > "$log"   # one run per log
# Start after Omarchy has put its still background up, so the fire is drawn over it.
[[ -n $WAYLAND_DISPLAY ]] || { echo "campfire-live: no Wayland session found (run it on the PC)" | tee -a "$log" >&2; exit 0; }
if (( login )); then   # the desktop is still coming up: let Omarchy put its still background up first
  sleep 4
  exec mpvpaper -o "$opts" '*' "$video" >>"$log" 2>&1 < /dev/null
fi
# From a theme change: run it as its own user unit, so it outlives omarchy-theme-set and whatever ran the hook.
if command -v systemd-run >/dev/null && systemctl --user show-environment >/dev/null 2>&1; then
  systemd-run --user --quiet --collect --unit=campfire-live \
    --setenv=XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR" --setenv=WAYLAND_DISPLAY="$WAYLAND_DISPLAY" \
    --setenv=HYPRLAND_INSTANCE_SIGNATURE="$HYPRLAND_INSTANCE_SIGNATURE" \
    -p StandardOutput="append:$log" -p StandardError="append:$log" \
    /bin/bash -c 'sleep 2; exec mpvpaper -o "$0" "*" "$1"' "$opts" "$video" && exit 0
fi
( sleep 2; exec setsid mpvpaper -o "$opts" '*' "$video" ) >>"$log" 2>&1 < /dev/null &
disown 2>/dev/null
exit 0
