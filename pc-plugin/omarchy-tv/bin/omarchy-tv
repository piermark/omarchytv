#!/usr/bin/env python3
"""omarchy-tv: Omarchy-style front-end for OmarchyTV (Android TV & LG webOS), built on omarchy-link.

  omarchy-tv [menu]                     Omarchy menu (omarchy-menu-select; Walker on older Omarchy; gum / numbered list over SSH)
  omarchy-tv status | pair | remote KEY | cast [TARGET]
  omarchy-tv play <PATH|URL> | pause | resume | stop | seek <SEC> | queue | ls | handoff | snippets | iptv | cinemarchy
  omarchy-tv send <FILE|URL> [--sub FILE.srt|.vtt|.ass|URL] [--queue] [--title T] [--at MM:SS] | send --pick
  omarchy-tv menu-entry install | remove | status   "Send to TV (Cinemarchy)" in the Omarchy menu (Omarchy 4.5+)
  omarchy-tv iptv list | add <M3U_URL> [--name NAME] [--epg XMLTV_URL] | remove <URL_OR_NAME>
  omarchy-tv wg push <wg0.conf> | up NAME | down NAME [--tv IP:5555]   WireGuard on the TV (official app)
  omarchy-tv adb-pair HOST:PAIRPORT CODE [--connect HOST:PORT]   Android 11+ Wireless debugging pairing (wraps adb pair)
  omarchy-tv adb-lock --tv IP:5555 [--yes]   close network ADB on the TV when done
  omarchy-tv plugins list | items ID | play ID N   sandboxed media-feed plugins (SpaceX TV built in)
  omarchy-tv screen start [--audio] | screen extend [1920x1080@30] [--audio] | screen stop     live "Schermo PC" (opt-in, H.264 MPEG-TS over the link)
  omarchy-tv themes list | push [NAME|--all] | select NAME [BG] | delete NAME
  omarchy-tv icons list | push [PACKAGE|--all] | delete PACKAGE   your own banners, ~/.config/omarchy-tv/banners/<package>.png
  omarchy-tv update <APK|IPK> [--tv IP:5555|DEVICE] [--yes] [--dry-run]
                                        Android (.apk): adb install -r, cert + versionCode checked
                                        LG webOS (.ipk): appinfo.json checked + ares-install
  omarchy-tv webos-serve [--port 8765] [--bind 0.0.0.0]
                                        LAN HTTP server for LG webOS TVs (/v1/status, /v1/themes, /v1/wallpaper)
  omarchy-tv stats                      show the stats pushed every 5 s while the TV home is visible
  omarchy-tv office push <bots.json> | show | clear   GrokBot Office: your bots and weekly usage on the TV (2.20, optional)
                                                       (+ Claude / ChatGPT bots: omarchy-link office hire)
  omarchy-tv mcp [--stdio|--http] [--port 8990] [--tunnel]   MCP server for Grok Bot / Claude / Hermes
"""
import os, sys
HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, os.path.join(HERE, "..", "lib"))
for cand in (os.environ.get("OMARCHY_LINK_LIB"), os.path.expanduser("~/.local/share/omarchy-link/lib"),
             os.path.join(HERE, "..", "..", "omarchy-link", "lib"),
             os.path.join(HERE, "..", "..", "..", "omarchy-link", "lib")):
    if cand and os.path.isdir(os.path.join(cand, "omarchy_link")):
        sys.path.insert(1, cand)
        exe = os.path.join(cand, "..", "bin", "omarchy-link")
        if os.path.isfile(exe):
            os.environ.setdefault("OMARCHY_LINK_BIN", os.path.realpath(exe))
        break
from omarchy_tv import ui, themes, update, banners, webos, mcp_server  # noqa: E402
from omarchy_tv.i18n import t  # noqa: E402

MENU = [("󰍹  " + t("menu.status"), "status"), ("󰌘  " + t("menu.pair"), "pair"), ("󰖟  " + t("menu.webos"), "webos-serve"),
        ("󰸌  " + t("menu.themes"), "themes"), ("󰍺  " + t("menu.screen"), "screen"), ("󰚰  " + t("menu.update"), "update"),
        ("󰄘  " + t("menu.cast"), "cast"), ("󰑔  " + t("menu.remote"), "remote")]


def client():
    from omarchy_link import config, client as link
    p = config.Pairing.load()
    if not p.paired:
        ui.say(t("not_paired"))
        raise SystemExit(3)
    return link.Client(p.tv, p.pc_id, not config.load_config().get("allowOtherSubnets"))


def cmd_themes(args):
    sub = args[0] if args else None
    if sub is None:
        subs = {t("themes.push"): "push", t("themes.list"): "list", t("themes.select"): "select", t("themes.delete"): "delete"}
        sub = subs.get(ui.choose(t("themes.prompt"), list(subs)) or "")
        if not sub:
            return 0
    c = client()
    if sub == "list":
        r = themes.list_tv(c)
        for th in r.get("themes", []):
            ui.say(t("themes.row", name=th['name'], n=len(th['backgrounds']), mb=th['bytes'] / 1e6))
        ui.say(t("themes.used", used=r.get('used', 0) / 1048576, cap=r.get('cap', themes.CAP) / 1048576))
        return 0
    if sub == "push":
        found = themes.user_themes()
        if "--all" in args:
            pick = found
        else:
            name = args[1] if len(args) > 1 else ui.choose(t("themes.push_prompt"), [th.name for th in found])
            pick = [th for th in found if th.name == name]
        if not pick:
            ui.say(t("themes.none")); return 1
        for th in pick:
            r = themes.push(c, th)
            ui.say(t("themes.pushed", name=r['name'], n=len(r['backgrounds']), mb=r['bytes'] / 1e6))
            ui.notify(t("themes.sent", name=r['name']))
        return 0
    if sub == "select":
        names = [th["name"] for th in themes.list_tv(c).get("themes", [])]
        name = args[1] if len(args) > 1 else ui.choose(t("themes.select_prompt"), names)
        if not name:
            return 0
        themes.select(c, name, int(args[2]) if len(args) > 2 else 0)
        ui.notify(t("themes.selected", name=name))
        return 0
    if sub == "delete":
        name = args[1] if len(args) > 1 else ui.choose(t("themes.delete_prompt"), [th["name"] for th in themes.list_tv(c).get("themes", [])])
        if name and ("--yes" in args or ui.confirm(t("themes.delete_confirm", name=name))):
            themes.delete(c, name)
            ui.say(t("themes.deleted", name=name))
        return 0
    ui.say(__doc__); return 2


def cmd_icons(args):
    sub = args[0] if args else None
    if sub is None:
        subs = {t("icons.push"): "push", t("icons.list"): "list", t("icons.delete"): "delete"}
        sub = subs.get(ui.choose(t("icons.prompt"), list(subs)) or "")
        if not sub:
            return 0
    if sub not in ("list", "push", "delete"):
        ui.say(__doc__); return 2
    c = client()
    try:
        tv = banners.list_tv(c)
    except Exception as e:
        if "404" in str(e) or "not_found" in str(e):
            ui.say(t("icons.unsupported")); return 1
        raise
    if sub == "list":
        for pkg in tv.get("banners", []):
            ui.say(t("icons.row", pkg=pkg))
        return 0
    if sub == "push":
        found = banners.local()
        if len(args) > 1 and args[1] != "--all":
            found = [f for f in found if f[0] == args[1]]
        if not found:
            ui.say(t("icons.none")); return 1
        for pkg, path in found:
            banners.push(c, pkg, path)
            ui.say(t("icons.pushed", pkg=pkg, kb=path.stat().st_size / 1024))
        ui.notify(t("icons.sent", n=len(found)))
        return 0
    pkg = args[1] if len(args) > 1 else ui.choose(t("icons.delete_prompt"), tv.get("banners", []))
    if pkg:
        banners.delete(c, pkg)
        ui.say(t("icons.deleted", pkg=pkg))
    return 0


def cmd_screen(args):
    """Live screen: delegates to omarchy-link cast --screen (gpu-screen-recorder / wf-recorder, hw encode if any)."""
    action = args[0] if args else (ui.choose(t("screen.prompt"), ["start", "start --audio", "extend", "stop"]) or "")
    if action.startswith("start"):
        env = dict(os.environ)
        if "--audio" in args or "--audio" in action:
            env["OMARCHY_LINK_SCREEN_AUDIO"] = "1"
        return ui.run(["omarchy-link", "cast", "--screen"], env=env)
    if action == "extend":  # 2.13: TV as a second Hyprland display
        from omarchy_tv import extend
        mode = next((a for a in args[1:] if not a.startswith("-")), None)
        return extend.start(mode, audio="--audio" in args, say=ui.say)
    if action == "stop":
        rc = ui.run(["omarchy-link", "cast", "--stop"])
        from omarchy_tv import extend
        extend.stop(say=ui.say)
        return rc
    return 0



def _query_mpv_ipc():
    """Inspect a running local mpv IPC socket (/tmp/mpv-socket or ~/.cache/omarchy-tv/mpv.sock) and pause it."""
    import json, socket as _sock
    for sock_path in (os.environ.get("OMARCHY_MPV_SOCKET"), "/tmp/mpv-socket", "/tmp/mpvsocket",
                      os.path.expanduser("~/.cache/omarchy-tv/mpv.sock")):
        if not sock_path or not os.path.exists(sock_path):
            continue
        try:
            with _sock.socket(_sock.AF_UNIX, _sock.SOCK_STREAM) as s:
                s.settimeout(0.8)
                s.connect(sock_path)
                def ask_prop(prop, req_id):
                    s.sendall((json.dumps({"command": ["get_property", prop], "request_id": req_id}) + "\n").encode())
                    for line in s.makefile():
                        obj = json.loads(line)
                        if obj.get("request_id") == req_id:
                            return obj.get("data")
                    return None
                path = ask_prop("path", 1)
                pos = ask_prop("time-pos", 2) or 0.0
                title = ask_prop("media-title", 3) or (os.path.basename(path) if path else "mpv stream")
                s.sendall((json.dumps({"command": ["set_property", "pause", True]}) + "\n").encode())
                if path:
                    return str(path), float(pos), str(title)
        except Exception:
            continue
    return None, 0.0, None



def cmd_snippets(args):
    """Print chapter-synced Omarchy Tutorial Mode CLI snippets."""
    if "-h" in args or "--help" in args:
        print("Usage: omarchy-tv snippets [--push FILE]\n"
              "  List chapter-synced Tutorial Mode CLI snippets (or push custom video snippets to the TV).")
        return 0
    snippets = [
        ("01:15", "Super + Space", "Open Walker launcher"),
        ("03:40", "Super + Alt + Space", "Open Omarchy system menu"),
        ("06:10", "omarchy-theme-set tokyo-night", "Switch system & TV theme live"),
        ("09:25", "omarchy-tv handoff", "Handoff active PC mpv playback -> TV"),
        ("11:50", "omarchy-tv handoff --back", "Pull TV playback -> local PC mpv"),
    ]
    for ts, cmd, desc in snippets:
        print(f"{ts}  {cmd:<32} # {desc}")
    return 0

def cmd_iptv(args):
    """Manage user-supplied M3U/M3U8 IPTV playlists and optional XMLTV EPG on the paired TV."""
    sub = args[0] if args else "list"
    if sub in ("-h", "--help", "help"):
        print("Usage: omarchy-tv iptv list | add <M3U_URL> [--name NAME] [--epg XMLTV_URL] | remove <URL_OR_NAME>\n"
              "  Only user-supplied playlists you have the right to watch; OmarchyTV bundles no channels.")
        return 0
    c = client()
    cur = c.request("GET", "/v1/cinemarchy/iptv")
    pls = list(cur.get("playlists") or [])
    epg = cur.get("epg") or ""
    if sub in ("list", "ls"):
        if not pls:
            ui.say("No IPTV playlists configured on the TV. Add one with: omarchy-tv iptv add https://.../playlist.m3u8")
        for i, p in enumerate(pls, 1):
            ui.say(f"  [{i}] {p.get('name','Playlist')}: {p.get('url','')}")
        if epg:
            ui.say(f"  EPG: {epg}")
        return 0
    if sub == "add":
        rest = args[1:]
        opt_vals = {rest[i + 1] for i, a in enumerate(rest[:-1]) if a in ("--name", "--epg")}
        url = next((a for a in rest if a.startswith(("http://", "https://")) and a not in opt_vals), "")
        name = rest[rest.index("--name") + 1] if "--name" in rest and rest.index("--name") + 1 < len(rest) else ""
        if "--epg" in rest and rest.index("--epg") + 1 < len(rest):
            epg = rest[rest.index("--epg") + 1]
        if not url and "--epg" not in rest:
            ui.say("Usage: omarchy-tv iptv add <https://.../playlist.m3u8> [--name NAME] [--epg XMLTV_URL]")
            return 1
        if url:
            pls = [p for p in pls if p.get("url") != url]
            pls.append({"name": name or url.split("/")[2], "url": url})
        c.request("PUT", "/v1/cinemarchy/iptv", {"playlists": pls, "epg": epg})
        ui.say(f"📺 Saved IPTV config on TV ({len(pls)} playlist(s)).")
        return 0
    if sub in ("remove", "rm", "del", "delete"):
        target = args[1] if len(args) > 1 else ""
        before = len(pls)
        pls = [p for p in pls if p.get("url") != target and p.get("name") != target]
        c.request("PUT", "/v1/cinemarchy/iptv", {"playlists": pls, "epg": epg})
        ui.say(f"Removed {before - len(pls)} playlist(s).")
        return 0
    ui.say("Usage: omarchy-tv iptv list | add <M3U_URL> [--name NAME] [--epg XMLTV_URL] | remove <URL_OR_NAME>")
    return 1


def cmd_handoff(args):
    """Seamless mpv <-> Cinemarchy TV handoff (preserves exact playback position in seconds)."""
    import subprocess
    if "--back" in args or "--to-pc" in args:
        c = client()
        st = c.request("GET", "/v1/status")
        r = c.request("POST", "/v1/cinemarchy/handoff-to-pc", {"title": "TV Handoff", "position": 0})
        ho = r.get("handoff") or {}
        url = ho.get("url") or (args[0] if args and not args[0].startswith("-") else "")
        pos = ho.get("position", 0)
        if url:
            subprocess.Popen(["mpv", f"--start=+{pos}", url])
            ui.say(f"▶ Resumed on PC mpv @ {pos:.1f}s: {url}")
        return 0
    target = None
    pos = 0.0
    title = None
    i = 0
    while i < len(args):
        if args[i] in ("--at", "--pos", "--position") and i + 1 < len(args):
            raw = args[i + 1]
            if ":" in raw:
                parts = [float(x) for x in raw.split(":")]
                pos = parts[0] * 60 + parts[1] if len(parts) == 2 else parts[0] * 3600 + parts[1] * 60 + parts[2]
            else:
                pos = float(raw)
            i += 2
        elif args[i] == "--title" and i + 1 < len(args):
            title = args[i + 1]
            i += 2
        elif not args[i].startswith("-") and target is None:
            target = args[i]
            i += 1
        else:
            i += 1
    if not target:
        target, ipc_pos, ipc_title = _query_mpv_ipc()
        if ipc_pos and not pos:
            pos = ipc_pos
        if ipc_title and not title:
            title = ipc_title
    if not target:
        ui.say("Usage: omarchy-tv handoff [<FILE|URL>] [--at MM:SS] (or run with mpv IPC at /tmp/mpv-socket)")
        return 1
    if target.startswith(("http://", "https://")):
        c = client()
        c.request("POST", "/v1/cinemarchy/handoff", {
            "url": target,
            "title": title or target,
            "position": pos,
            "from": "mpv · Omarchy PC"
        })
        ui.say(f"🎬 Handed off to Cinemarchy TV @ {pos:.1f}s: {title or target}")
        return 0
    cast_args = ["omarchy-link", "cast", target]
    if pos > 0:
        cast_args += ["--position", str(int(pos))]
    return ui.run(cast_args)


def cmd_webos_serve(args):
    port = int(args[args.index("--port") + 1]) if "--port" in args else 8765
    bind = args[args.index("--bind") + 1] if "--bind" in args else "0.0.0.0"
    once = "--once" in args
    return webos.serve(bind=bind, port=port, once=once)


def main(argv):
    args = argv[1:]
    cmd = args[0] if args else "menu"
    rest = args[1:]
    if cmd == "menu":
        pick = ui.choose("OmarchyTV…", [m[0] for m in MENU])
        cmd = dict(MENU).get(pick or "", "")
        if not cmd:
            return 0
    if cmd in ("pair", "status", "cast"):
        return ui.run(["omarchy-link", cmd] + rest)
    if cmd == "play":
        return ui.run(["omarchy-link", "cast"] + rest)
    if cmd in ("pause", "resume"):
        return ui.run(["omarchy-link", "key", "play_pause"])
    if cmd == "stop":
        return ui.run(["omarchy-link", "cast", "--stop"])
    if cmd == "seek":
        sec = int(rest[0]) if rest else 0
        c = client()
        c.request("POST", "/v1/media", {"action": "seek", "position": sec})
        return 0
    if cmd == "handoff":
        return cmd_handoff(rest)
    if cmd == "snippets":
        return cmd_snippets(rest)
    if cmd == "iptv":
        return cmd_iptv(rest)
    if cmd == "plugins":
        from omarchy_tv import plugins
        return plugins.run(rest, client, say=ui.say)
    if cmd == "adb-pair":
        from omarchy_tv import adb_pair
        return adb_pair.run(rest, say=ui.say)
    if cmd == "adb-lock":
        from omarchy_tv import adb_lock
        return adb_lock.run(rest, say=ui.say, confirm=ui.confirm)
    if cmd in ("wg", "wireguard"):
        from omarchy_tv import wireguard
        return wireguard.run(rest, say=ui.say)
    if cmd == "send":
        from omarchy_tv import send
        return send.run(rest, client, picker=lambda: send.pick_file(ui.choose), notify=ui.notify)
    if cmd == "office":
        from omarchy_tv import office
        return office.run(rest, client, say=ui.say)
    if cmd == "menu-entry":
        from omarchy_tv import menu_entry
        return menu_entry.run(rest, os.path.realpath(__file__), say=ui.say)
    if cmd in ("queue", "ls", "cinemarchy"):
        c = client()
        r = c.request("GET", "/v1/cinemarchy/library")
        for it in r.get("items", []):
            ui.say(f"🎬 {it.get('title','')}  ({it.get('subtitle','')})")
        return 0
    if cmd == "remote":
        return ui.run(["omarchy-link", "key", rest[0] if rest else (ui.choose(t("remote.prompt"), ["home", "back", "up", "down", "left", "right", "ok", "play_pause"]) or "home")])
    if cmd == "themes":
        return cmd_themes(rest)
    if cmd == "screen":
        return cmd_screen(rest)
    if cmd == "icons":
        return cmd_icons(rest)
    if cmd in ("webos-serve", "webos"):
        return cmd_webos_serve(rest)
    if cmd == "mcp":
        port = int(rest[rest.index("--port") + 1]) if "--port" in rest else 8990
        if "--http" in rest or "--tunnel" in rest:
            return mcp_server.serve_http(client, port=port, tunnel="--tunnel" in rest)
        return mcp_server.serve_stdio(client)
    if cmd == "stats":
        from omarchy_link import stats, config
        ui.say(str(stats.payload(config.load_config())))
        return 0
    if cmd == "update":
        apk = rest[0] if rest and not rest[0].startswith("-") else ui.ask(t("update.apk_prompt"))
        tv = rest[rest.index("--tv") + 1] if "--tv" in rest else (rest[rest.index("--device") + 1] if "--device" in rest else None)
        return update.update(apk, tv, dry_run="--dry-run" in rest, yes="--yes" in rest)
    ui.say(__doc__)
    return 2


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv))
    except Exception as e:  # LinkError, ValueError, OSError: one Omarchy-style line + notification
        ui.say(f"✗ {e}")
        ui.notify(t("error", e=e))
        sys.exit(1)
