[{"event_categories": [{"category_id": "7b0adf61-0a93-4e3d-a7ef-1fee93c2591f", "category_timing_id": 1, "timing_id": 22, "extra_timing_id": null, "sequence": 22, "num_laps": 20, "sprint_num_laps": null, "red_flag": 15, "sprint_red_flag": null, "distance": {"meters": 80100, "kiloMeters": 80.1, "miles": 49.77, "feet": 262795.28}}, {"category_id": "93888447-8746-4161-882c-e08a1d48447e", "category_timing_id": 3, "timing_id": 22, "extra_timing_id": null, "sequence": 22, "num_laps": 27, "sprint_num_laps": 13, "red_flag": 20, "sprint_red_flag": 10, "distance": {"meters": 108135, "kiloMeters": 108.14, "miles": 67.19, "feet": 354773.63}}, {"category_id": "bc2b0143-1bfb-4ad0-9501-da2e474e3ea7", "category_timing_id": 2, "timing_id": 22, "extra_timing_id": null, "sequence": 22, "num_laps": 22, "sprint_num_laps": null, "red_flag": 17, "sprint_red_flag": null, "distance": {"meters": 88110, "kiloMeters": 88.11, "miles": 54.75, "feet": 289074.81}}], "country": "ES", "circuit": {"id": "c5e48a7a-42d3-4e5d-8a40-2efc77eb36b6", "name": "Circuit Ricardo Tormo", "iso_code": "ES", "country": "Spain", "region": "VC", "city": "Cheste", "postal_code": "46380", "address": "Salida, Autov\u00eda del Este, 334, 46380 Madrid, Valencia, Spain", "lat": "39.4848428", "lng": "-0.6265042", "place_id": "ChIJn1iBxLHwYA0R9ErxCUURNkQ", "constructed": 1999, "designer": "Antonio Risue\u00f1o Galindo", "modified": null, "capacity": null, "active": true, "timing_id": 77, "tracks": [{"id": "795839a0-8faa-4f4e-a574-8dce32cfc560", "first_grid": "1", "box_entry": true, "box_exit": false, "lenght": "4005", "lenght_units": {"meters": 4005, "kiloMeters": 4.01, "miles": 2.49, "feet": 13139.76}, "width": "12", "width_units": {"meters": 12, "kiloMeters": 0.01, "miles": 0.01, "feet": 39.37}, "longest_straight": "876", "longest_straight_units": {"meters": 876, "kiloMeters": 0.88, "miles": 0.54, "feet": 2874.02}, "left_corners": "9", "right_corners": "5", "is_active": true, "timing_ids": [{"business_unit": "MGP", "id": "77"}, {"business_unit": "RKC", "id": "77"}, {"business_unit": "CEV", "id": "77"}, {"business_unit": "ATC", "id": "77"}], "modification_date": "1999-09-17T00:00:00+00:00", "assets": {"info": {"id": "2e772f09-d2e3-4f6d-a2f0-b52af513e9ef", "name": "v2al-info.svg", "type": "INFO", "path": "https://photos.motogp.com/events-admin/7/9/795839a0-8faa-4f4e-a574-8dce32cfc560/info/v2al-info.svg", "mimetype": "SVG"}, "simple": {"id": "c721d9de-858c-4870-9939-93a9870506e0", "name": "val.png", "type": "SIMPLE", "path": "https://photos.motogp.com/events-admin/7/9/795839a0-8faa-4f4e-a574-8dce32cfc560/simple/val.png", "mimetype": "PNG"}}}], "circuit_descriptions": [{"id": "033ae507-1140-4294-98f2-2f77a026038b", "business_unit_id": {"id": "d6ced16c-c25e-4f61-bfa5-4683679ff873"}, "business_unit_name": {"value": "MotoGP\u2122"}, "language": "fr", "description": "Inaugur\u00e9 en 1999, le circuit de la Communaut\u00e9 de Valence a accueilli les Championnats du Monde MotoGP et d\u2019Espagne la m\u00eame ann\u00e9e. Le circuit de Cheste propose plusieurs trac\u00e9s et celui retenu pour les \u00e9preuves MotoGP est long de 4 km, avec cinq virages \u00e0 droite, huit virages \u00e0 gauche et une ligne droite de 876m. S\u2019il s\u2019agit d\u2019un \u2018petit\u2019 circuit, les installations sont impressionnantes : les pits comprennent 48 garages tandis que les tribunes peuvent accueillir pr\u00e8s de 150 000 spectateurs. La configuration du circuit permet de cr\u00e9er une ambiance unique sur un trac\u00e9 particuli\u00e8rement appr\u00e9ci\u00e9 par les pilotes espagnols et \u00e9trangers."}, {"id": "2456bed5-20f2-4f9c-aaae-e229acb24872", "business_unit_id": {"id": "d6ced16c-c25e-4f61-bfa5-4683679ff873"}, "business_unit_name": {"value": "MotoGP\u2122"}, "language": "en", "description": "The Circuito de la Comunitat Valenciana was completed in 1999 and held rounds of the MotoGP and Spanish Motorcycle Championships in the same year. The Cheste track has several layouts, running anti-clockwise with varying lengths. MotoGP events are held on a 4km track comprising of five right handed corners, eight left handers and a 876m straight. Although the track is regarded as quite small, the pit complex contains 48 garages whilst the stadium style grandstands can seat up to 150,000 spectators. The circuit layout which allows all parts of the circuit to be seen from any stand helps to create a unique atmosphere enjoyed by Spanish and international riders alike and as the last race of the season there is always a party feeling to the Grand Prix, which was voted best GP of 2005 by IRTA."}, {"id": "2a58267a-df40-4eac-a55b-f0f66f64fbf0", "business_unit_id": {"id": "d6ced16c-c25e-4f61-bfa5-4683679ff873"}, "business_unit_name": {"value": "MotoGP\u2122"}, "language": "pt", "description": "O Circuito de la Comunitat Valenciana foi conclu\u00eddo em 1999 e, j\u00e1 no mesmo ano, recebeu etapas da MotoGP e do Campeonato Espanhol de Motociclismo. Localizado em Cheste, o tra\u00e7ado conta com diferentes configura\u00e7\u00f5es e \u00e9 percorrido no sentido anti-hor\u00e1rio, com varia\u00e7\u00f5es de extens\u00e3o conforme a categoria.\n\nNa MotoGP\u2122, a pista utilizada tem 4 km de comprimento, com cinco curvas para a direita, oito para a esquerda e uma reta de 876 metros. Embora seja considerado um circuito relativamente compacto, sua infraestrutura impressiona: o complexo de boxes disp\u00f5e de 48 garagens e as arquibancadas em estilo est\u00e1dio comportam at\u00e9 150 mil espectadores.\n\nUm dos grandes diferenciais de Val\u00eancia \u00e9 o desenho do circuito, que permite visualizar praticamente toda a pista a partir de qualquer setor das arquibancadas. Isso cria uma atmosfera \u00fanica, intensa, quase de arena, que contagia pilotos e torcedores. E como tradicionalmente recebe a \u00faltima etapa da temporada, o clima \u00e9 sempre de decis\u00e3o, emo\u00e7\u00e3o e festa. N\u00e3o por acaso, o Grande Pr\u00eamio foi eleito o melhor de 2005 pela IRTA. Em Val\u00eancia, a temporada se despede em alto volume, com arquibancadas vibrando e hist\u00f3rias sendo escritas at\u00e9 a \u00faltima bandeirada."}, {"id": "30a45154-dc54-4237-a1e9-29f7834a0d5c", "business_unit_id": {"id": "d6ced16c-c25e-4f61-bfa5-4683679ff873"}, "business_unit_name": {"value": "MotoGP\u2122"}, "language": "es", "description": "El circuito de la Comunitat Valenciana Ricardo Tormo ha albergado eventos de MotoGP desde su inauguraci\u00f3n en 1999.. Con un dise\u00f1o deudor de la influencia americana, en numerosas posiciones los espectadores cuentan con una visi\u00f3n de todo el trazado, que se localiza muy cerca de la poblaci\u00f3n de Cheste. El circuito juega un importante papel en la zona, ya que alrededor de 2.000 personas trabajan en sus instalaciones cuando el MotoGP\u2122 acude a su cita anual. El circuito recibe el nombre del recordado Campe\u00f3n del Mundo de 50cc -el primer valenciano en conquistar un t\u00edtulo mundial- fallecido en 1998 tras perder la batalla contra la leucemia."}, {"id": "4f765358-2983-4241-8779-bbfda89667f5", "business_unit_id": {"id": "d6ced16c-c25e-4f61-bfa5-4683679ff873"}, "business_unit_name": {"value": "MotoGP\u2122"}, "language": "ja", "description": "<p>\u30d0\u30ec\u30f3\u30b7\u30a2\u5dde\u653f\u5e9c\u304c\u5dde\u90fd\u30d0\u30ec\u30f3\u30b7\u30a2\u90ca\u5916\u306e\u30c1\u30a7\u30b9\u30c6\u306b\u5efa\u8a2d\u3057\u305f\u30b5\u30fc\u30ad\u30c3\u30c8\u3001\u30b7\u30eb\u30af\u30a4\u30fc\u30c8\u30fb\u30c7\u30fb\u30e9\u30fb\u30b3\u30e0\u30cb\u30bf\u30fb\u30d0\u30ec\u30f3\u30b7\u30a2\u30fc\u30ca\u306f\u3001\uff11\uff19\uff19\uff19\u5e74\uff19\u6708\u306e\u30aa\u30fc\u30d7\u30cb\u30f3\u30b0\u30a4\u30d9\u30f3\u30c8\u3068\u3057\u3066\u4e16\u754c\u9078\u624b\u6a29\u3092\u958b\u50ac\u3059\u308b\u3068\u3001\uff12\uff10\uff10\uff12\u5e74\u304b\u3089\u306f\u6bce\u5e74\u6700\u7d42\u6226\u3092\u958b\u50ac\u3002</p>\n<p>\u30c1\u30e3\u30f3\u30d4\u30aa\u30f3\u30b7\u30c3\u30d7\u3067\u552f\u4e00\u306e\u30b9\u30bf\u30b8\u30a2\u30e0\u30b9\u30bf\u30a4\u30eb\u306e\u30b5\u30fc\u30ad\u30c3\u30c8\u3068\u3057\u3066\u3001\u89b3\u5ba2\u5e2d\u304b\u3089\uff11\u5468\uff14\uff10\uff10\uff15\u30e1\u30fc\u30c8\u30eb\u306e\u30c8\u30e9\u30c3\u30af\u3092\u4e00\u671b\u3067\u304d\u3001\u6bce\u5e74\uff12\uff10\u4e07\u4eba\u3092\u8d85\u3048\u308b\u30d5\u30a1\u30f3\u304c\u6765\u5834\u3059\u308b\u3002</p>\n<p>\u30b5\u30fc\u30ad\u30c3\u30c8\u306e\u540d\u79f0\u306f\u3001\uff11\uff19\uff19\uff18\u5e74\u306b\u767d\u8840\u75c5\u304c\u539f\u56e0\u3067\u4ed6\u754c\u3057\u305f\u5730\u5143\u306e\u82f1\u96c4\u3067\u3042\u308a\u3001\uff11\uff19\uff17\uff18\u5e74\u3068\uff11\uff19\uff18\uff11\u5e74\u306b\u300e50cc\u300f\u3067\u30c1\u30e3\u30f3\u30d4\u30aa\u30f3\u306b\u8f1d\u3044\u305f\u30ea\u30ab\u30eb\u30c9\u30fb\u30c8\u30eb\u30e2\u306e\u529f\u7e3e\u3092\u79f0\u3048\u3001\uff12\uff10\uff11\uff17\u5e74\u306b\u30b5\u30fc\u30ad\u30c3\u30c8\u30fb\u30ea\u30ab\u30eb\u30c9\u30fb\u30c8\u30eb\u30e2\u306b\u6539\u540d\u3002</p>\n<p>\uff12\uff10\uff11\uff18\u5e74\u304b\u3089\u6bce\u5e74\u89b3\u5ba2\u5e2d\u3092\u5897\u52a0\u3002\uff12\uff10\uff12\uff10\u5e74\u306f\u30b7\u30fc\u30ba\u30f3\u6700\u7d42\u6226\u3068\u3057\u3066\uff11\uff11\u6708\uff11\uff15\u65e5\u306b\u6c7a\u52dd\u30ec\u30fc\u30b9\u3092\u4e88\u5b9a\u3057\u3066\u3044\u305f\u304c\u3001\u30d1\u30f3\u30c7\u30df\u30c3\u30af\u306e\u5f71\u97ff\u3092\u53d7\u3051\u3066\u3001\uff11\uff11\u6708\uff18\u65e5\u306b\u7b2c\uff11\uff13\u6226\u30e8\u30fc\u30ed\u30c3\u30d1\uff27\uff30\u3001\u7fcc\u9031\u306e\uff11\uff11\u6708\uff11\uff15\u65e5\u306b\u7b2c\uff11\uff14\u6226\u30d0\u30ec\u30f3\u30b7\u30a2\uff27\uff30\u3092\u958b\u50ac\u3002</p>\n<p>\uff12\uff10\uff12\uff10\u5e74\uff12\u6708\u3001\u30d0\u30ec\u30f3\u30b7\u30a2\u5dde\u653f\u5e9c\u3068\u30c9\u30eb\u30ca\u30b9\u30dd\u30fc\u30c4\u3068\u306e\u9593\u3067\u3001\uff12\uff10\uff12\uff12\u5e74\u304b\u3089\uff12\uff10\uff12\uff16\u5e74\u307e\u3067\u306e\uff15\u5e74\u9593\u3067\u5c11\u306a\u304f\u3066\u3082\uff13\u56de\u306e\u958b\u50ac\u306b\u95a2\u3057\u3066\u5408\u610f\u3002</p>\n<p>\uff12\uff10\uff12\uff14\u5e74\u306f\uff11\uff10\u6708\u4e0b\u65ec\u306b\u30b9\u30da\u30a4\u30f3\u6771\u90e8\u3092\u8972\u3063\u305f\u8c6a\u96e8\u306b\u3088\u308b\u5927\u6d2a\u6c34\u306e\u5f71\u97ff\u3092\u53d7\u3051\u305f\u3053\u3068\u304b\u3089\u3001\u958b\u50ac\u304c\u898b\u9001\u3089\u308c\u3001\u4ee3\u66ff\u3068\u3057\u3066\u3001\u30d0\u30eb\u30bb\u30ed\u30ca\uff0d\u30ab\u30bf\u30eb\u30fc\u30cb\u30e3\u30fb\u30b5\u30fc\u30ad\u30c3\u30c8\u3067\u958b\u50ac\u3002\u30c1\u30e3\u30f3\u30d4\u30aa\u30f3\u30b7\u30c3\u30d7\u306f\u6d2a\u6c34\u306e\u88ab\u5bb3\u3092\u53d7\u3051\u305f\u30b5\u30fc\u30ad\u30c3\u30c8\u304c\u4f4d\u7f6e\u3059\u308b\u30c1\u30a7\u30b9\u30c6\u5e02\u3068\u8fd1\u96a3\u306e\u30c1\u30d0\u5e02\u306b\u7d04\uff11\uff16\uff10\u4e07\u30e6\u30fc\u30ed\uff08\u7d04\uff12.\uff15\u5104\u5186\uff09\u3092\u5bc4\u4ed8\u3002</p>\n<p>\uff12\uff17\u56de\u76ee\u306e\u30a4\u30d9\u30f3\u30c8\u3068\u306a\u308b\uff12\uff10\uff12\uff16\u5e74\u306f\u3001\u30b7\u30fc\u30ba\u30f3\uff12\uff12\u6226\u76ee\u3001\u6700\u7d42\u6226\u3068\u3057\u3066\uff11\uff11\u6708\uff12\uff17\u65e5\u304b\u3089\uff12\uff19\u65e5\u306b\u958b\u50ac\u3002</p>\n"}, {"id": "bc57030a-7cce-4b15-87c5-e6680e37ee15", "business_unit_id": {"id": "d6ced16c-c25e-4f61-bfa5-4683679ff873"}, "business_unit_name": {"value": "MotoGP\u2122"}, "language": "de", "description": "Der Circuito de la Comunitat Valenciana wurde 1999 fertig gestellt und beherbergte noch im selben Jahr den MotoGP und die Spanischen Motorradmeisterschaften. Die Cheste Rennstrecke hat verschiedene Streckenf\u00fchrungen, die in unterschiedlichen L\u00e4ngen gegen den Uhrzeigersinn laufen. MotoGP Veranstaltungen finden auf der vier Kilometer langen Strecke statt, die aus f\u00fcnf Rechtskurven, sieben Linkskurven und einer 876 Meter langen Gerade besteht. Obwohl man die Strecke als relativ klein ansieht, umfasst der Boxen Komplex 48 Garagen und die Stadiumshaupttrib\u00fcne bietet Sitzgelegenheiten f\u00fcr 150 000 Zuschauer. Die Machart der Rennstrecke schafft eine einzigartige Atmosph\u00e4re, die von spanischen und internationalen Fahrern gleicherma\u00dfen gesch\u00e4tzt wird. Da dort das letzte Rennen der Saison stattfinden wird, ist die Party-Stimmung beim Grand Prix schon jetzt gesichert. Die Strecke wurde zudem von der IRTA 2005 zum besten GP erkl\u00e4rt."}, {"id": "ef2c4286-e001-46ca-91d0-b06d870684d7", "business_unit_id": {"id": "d6ced16c-c25e-4f61-bfa5-4683679ff873"}, "business_unit_name": {"value": "MotoGP\u2122"}, "language": "it", "description": "Il circuito della Comunit\u00e0 di Valencia, terminato nel 1999, ha accolto il suo primo Gran Premio e le prime competizioni del Campionato Spagnolo nello stesso anno. La pista contiene diverse tracciati, di lunghezze differenti che girano in senso inverso alle lancette dell'orologio. Il Gran Premio si sviluppa su una pista di 4 km che presenta cinque virate di destra, otto di sinistra e un rettilineo di 876 metri. Sebbene il circuito sia abbastanza piccolo, l'edificio principale ospita quarantotto boxes e le lunghe tribune che circondano la pista come in uno stadio possono contenere oltre 150.000 spettatori. Il disegno del circuito crea un ambiente unico goduto sia dai piloti che dal pubblico valenciano entusiasta. Un ambiente che quest'anno dar\u00e0 origine senza dubbio ad un'autentica festa, dato che sar\u00e0 l'ultimo Gran Premio del calendario. "}], "user_location": {"lat": "39.487719", "lng": "-0.628912", "radius": 2000}, "track": {"id": "795839a0-8faa-4f4e-a574-8dce32cfc560", "first_grid": "1", "box_entry": true, "box_exit": false, "lenght": "4005", "lenght_units": {"meters": 4005, "kiloMeters": 4.01, "miles": 2.49, "feet": 13139.76}, "width": "12", "width_units": {"meters": 12, "kiloMeters": 0.01, "miles": 0.01, "feet": 39.37}, "longest_straight": "876", "longest_straight_units": {"meters": 876, "kiloMeters": 0.88, "miles": 0.54, "feet": 2874.02}, "left_corners": "9", "right_corners": "5", "is_active"